# Macro-Driven Rotation Agent Environment Configuration
# Set these environment variables before running (do not use .env files)

# Pandadata credentials
PANDA_DATA_USERNAME=YOUR_PANDADATA_USERNAME
PANDA_DATA_PASSWORD=YOUR_PANDADATA_PASSWORD

# Optional: data date range
PANDA_DATA_START_DATE=2024-01-01
PANDA_DATA_END_DATE=2026-07-22

# Optional: skill paths (for agent orchestration; use your local absolute paths)
MACRO_MONITOR_SKILL_ROOT=/path/to/skill-macro-monitor
MACRO_ALTDATA_NOWCAST_SKILL_ROOT=/path/to/skill-macro-altdata-nowcast
INDEX_VALUATION_ROTATION_SKILL_ROOT=/path/to/skill-index-valuation-rotation
PANDADATA_SKILL_ROOT=/path/to/skill-pandadata-api
